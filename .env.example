# ==============================================================================
# Clip Bay Configuration
# ==============================================================================

# Required: Google Gemini API Key
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Optional: Max retries for transient Gemini 400 errors (default: 3)
GEMINI_MAX_RETRIES=3

# Optional: Download max height cap to save bandwidth (e.g. 480, 720, 1080, or empty for best)
MAX_HEIGHT=480

# Optional: FFmpeg stream copy mode (1 = fast keyframe cut, 0 = slower frame-accurate re-encode)
STREAM_COPY=1

# Optional: Maximum concurrent FFmpeg cut processes (default: min(CPU_COUNT, 8))
MAX_PARALLEL_CUTS=4

# Optional: Explicit path to ffmpeg executable (if not found in PATH or bundled folder)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: Server host & port configuration
HOST=0.0.0.0
PORT=5000

# Optional: Flask debug mode (0 = off/production, 1 = on/development)
FLASK_DEBUG=0

# Optional: Hours before old job outputs and downloads are automatically cleaned up (default: 24)
JOB_TTL_HOURS=24
